# Render server configuration
PORT=1000
NODE_ENV=production

# MongoDB Atlas connection string (KEEP SECRET; set this in Render Environment Variables)
MONGODB_URI=mongodb://USERNAME:PASSWORD@HOSTS/skardu_dryfruits?ssl=true&authSource=admin&retryWrites=true&w=majority

# JWT authentication secret (KEEP SECRET; set this in Render Environment Variables)
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origin(s), comma-separated
CLIENT_URL=https://your-frontend.vercel.app

# Vercel frontend build variable (PUBLIC; safe to expose in browser)
VITE_API_URL=https://your-render-service.onrender.com
